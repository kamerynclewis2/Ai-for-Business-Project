# Copy this template to proxy/.env.local (never commit .env.local to git)
CREWLY_AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
CREWLY_OPENAI_MODEL=gpt-6-luna

